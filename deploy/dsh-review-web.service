[Unit]
Description=DSH Plugin Review · Web (Next.js)
Documentation=https://github.com/furongjun-lingshu/dsh-plugin-reviews
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/srv/dsh-plugin-review
EnvironmentFile=/srv/dsh-plugin-review/.env.local
# 走自定义 server（server.mjs）而不是 Next 的 CLI：
# 只有它能在生产下打出**每请求一行、含状态码与耗时**的访问日志
# （Next 自带的 incomingRequests 日志只在 dev 生效，实测生产下不出一行）。
# 端口/绑定地址由环境变量给：PORT=80、DSH_REVIEW_HOST=0.0.0.0。
Environment=PORT=80
Environment=DSH_REVIEW_HOST=0.0.0.0
ExecStart=/usr/local/bin/node /srv/dsh-plugin-review/server.mjs
Restart=always
RestartSec=3

# 监听 80 需要特权端口，但**不需要 root**：只给这一个能力。
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dsh-review-web

[Install]
WantedBy=multi-user.target
