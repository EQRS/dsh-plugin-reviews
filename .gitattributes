# 行尾规范化：让 Windows 批处理在任何克隆上都是 CRLF，否则 cmd.exe 会报语法错。
*.cmd text eol=crlf
*.bat text eol=crlf

# 文本文件统一 LF（跨平台一致），检出时按平台转换。
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf

# systemd 单元文件**必须**是 LF：CRLF 会让 systemd 解析出带 \r 的值
# （在 Windows 上 clone 再传到服务器时真会踩到 —— core.autocrlf=true）。
*.service text eol=lf

# 容器相关同理：Dockerfile 里的续行与 heredoc 被塞进 \r 会构建出莫名其妙的结果；
# compose.yaml 已是 *.yml 覆盖，这里再显式列一次，免得有人只改这一处。
Dockerfile    text eol=lf
*.dockerfile  text eol=lf
.dockerignore text eol=lf
compose.yaml  text eol=lf

# 可执行脚本（Linux 上直接跑）
*.sh text eol=lf

# 二进制：不要做任何行尾转换。
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.sqlite binary

# 锁文件：语言统计与 diff 噪音大，标记为生成物。
package-lock.json linguist-generated=true
