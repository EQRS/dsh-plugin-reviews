# 本切片本地配置示例。复制为 .env.local 后按需修改。
# 数据库文件：位于仓库内 .data/ 目录（本地持久目录的最小替代）。
DSH_REVIEW_DB_PATH=.data/app.sqlite

# 站点正式 origin（生产必须有明确值，不能默认 localhost）。
SITE_ORIGIN=http://127.0.0.1:3100

# GitHub OAuth：未配置时登录走「未配置」明确错误，不伪装可用。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 会话 Cookie 签名/加密共享密钥（至少 32 字节）。
# 用于 oauth 挑战信封与 cookie 派生；未设置时仅测试环境可用内存随机值。
SESSION_SECRET=

# 首个管理员 GitHub 稳定 ID（部署时指定）。留空则不自动授予管理员。
BOOTSTRAP_ADMIN_GITHUB_ID=

# 联网探针测试开关：默认关闭，避免把「没网」写成「功能坏了」。
RUN_NETWORK=0
