# 本切片本地配置示例。复制为 .env.local 后按需修改。
#
# 复制命令（Windows）：
#   copy .env.example .env.local   （或在仓库根目录手动新建 .env.local）

# 数据库文件：位于仓库内 .data/ 目录（本地持久目录的最小替代）。
DSH_REVIEW_DB_PATH=.data/app.sqlite

# 本地媒体根目录（图片原图与展示图的落盘位置）。
# 留空则使用 .data/media。
DSH_REVIEW_MEDIA_ROOT=

# 站点正式 origin。
# ⚠️ **当前代码还没有读取这个变量**（预留给将来的绝对链接 / 邮件 / 分享卡片）。
#    真正决定登录回调的是下面的 GITHUB_REDIRECT_URI —— 那个必须与 OAuth App 里填的一致。
#    这里如实标注，免得有人以为改了这行就能换域名。
SITE_ORIGIN=http://127.0.0.1:3100

# ---------------------------------------------------------------------------
# GitHub 登录（OAuth App）
# ---------------------------------------------------------------------------
# 在 https://github.com/settings/developers 新建 OAuth App：
#   Application name          随意，例如 dsh-plugin-reviews-local
#   Homepage URL              http://127.0.0.1:3100
#   Authorization callback URL  http://127.0.0.1:3100/api/auth/github/callback
# 建好后把 Client ID 与 Client secret 填到下面两行。
#
# 留空时：站点会明确显示「GitHub 登录尚未配置」，**不会伪装成可用**。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 必须与 OAuth App 里填的 callback 完全一致（含协议、端口、路径）。
# 用 127.0.0.1 而不是 localhost，避免解析差异导致回调不匹配。
GITHUB_REDIRECT_URI=http://127.0.0.1:3100/api/auth/github/callback

# 可选的 GitHub 访问令牌：仅用于提高**插件收录检查**的接口限额
# （匿名 60 次/小时 → 带令牌 5000 次/小时）。与登录无关，可留空。
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# 其他
# ---------------------------------------------------------------------------
# 会话与登录挑战的共享密钥（至少 32 字节）。
# **生产环境必须设置**：否则服务端拒绝发起 GitHub 登录，避免明文保存 PKCE verifier。
SESSION_SECRET=

# 首个管理员：GitHub **稳定数字 ID**（部署时指定）。
#   取值：浏览器打开 https://api.github.com/users/<你的用户名> 看 "id" 字段，
#         或在本机执行 gh api user --jq .id（需已 gh auth login）。
#   ⚠️ 不要用用户名 —— 用户名可以改，认它等于给了个可伪造的身份。
# 语义是"引导"，不是"永久提权"：**只有当库里一个可用管理员都没有时**才生效。
#   因此被其他管理员撤销过权限的账号，不会因为这一行在下次登录时自己变回管理员。
# 留空则不自动授予管理员（此时用 scripts/grant-admin.mjs 上机指定）。
BOOTSTRAP_ADMIN_GITHUB_ID=

# 测试登录通道开关：仅用于本地跑 HTTP 验收脚本。
# 值必须正好是 1；**生产环境(NODE_ENV=production)下即使设为 1 也不生效**。
DSH_REVIEW_ALLOW_TEST_LOGIN=

# ---------------------------------------------------------------------------
# 内容筛查（决定提交能否自动发布）
# ---------------------------------------------------------------------------
# 留空（默认）：**不自动放行**。规则校验通过后进入 manual_review，等管理员人工决定。
#   —— 这是保守且安全的默认值，宁可不放行，也不假装审核过。
#
# basic：启用**本地确定性基础筛查**（明显垃圾/违规词表 + 长度下限）。
#   通过 → approved（可自动发布）；命中 → needs_changes。
#   仅用于本地开发与演示，**不是真实内容审核服务**；生产必须换成真实供应商，
#   因为本地词表无法覆盖真实风险，把它当成审核门会给出虚假的安全感。
DSH_REVIEW_CONTENT_SCREEN=

# ---------------------------------------------------------------------------
# 插件收录探针
# ---------------------------------------------------------------------------
# 设为 1 时，收录检查不做出网调用，直接报 provider_not_configured。
# 用于离线开发与 CI（避免把「没网」误判成「仓库不合规」）。
DSH_REVIEW_CATALOG_OFFLINE=

# 联网探针测试开关：默认关闭，避免把「没网」写成「功能坏了」。
RUN_NETWORK=0
